# SysWisdom Guardrails — Environment Configuration
# Copy this file to .env and add your actual values
# IMPORTANT: Never commit .env to version control!

# SysWisdom Data Quality API
# Get your API key from: https://www.syswisdom.ai
dq_api_key=YOUR_SYSWISDOM_API_KEY_HERE
dq_api_url=https://data-quality-api-u2mjys756a-uc.a.run.app/analyze

# Node Environment
# Development, staging, or production
NODE_ENV=development

# Server Config (optional)
PORT=3000
HOST=localhost

# Database Config (if using persistent storage)
# DB_URL=your_database_url_here

# Logging
LOG_LEVEL=info

# Authentication (if implementing auth)
SESSION_SECRET=your_session_secret_here
