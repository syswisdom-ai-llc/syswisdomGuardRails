# SysWisdom Guardrails Environment Configuration
# Copy this file to .env and fill in your actual values
# All keys marked (optional) are blank by default — features work without them.

# ── Core API ──────────────────────────────────────────────────────────────────
# SysWisdom Data Quality API (required)
# Get your key at: https://www.syswisdom.ai/data-quality-score
dq_api_key=YOUR_API_KEY_HERE
dq_api_url=https://data-quality-api-u2mjys756a-uc.a.run.app/analyze

# ── HuggingFace Hub (optional) ────────────────────────────────────────────────
# Required for gated datasets and higher rate limits. Public datasets work without it.
# Get a free read token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ── AI Connectors (optional — planned features) ───────────────────────────────
# Google Gemini: chaos narratives, AI fix suggestions, AI Readiness Score
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI ChatGPT: alternative AI backend (planned)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude: alternative AI backend (planned)
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Atlassian / Jira (optional — planned) ─────────────────────────────────────
# Auto-create Jira tickets from quality issues, post reports to Confluence
# Create token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# ── Azure DevOps (optional — planned) ─────────────────────────────────────────
# Pipeline quality gates and Work Item creation
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# ── Database Connections — SQL (optional — planned) ───────────────────────────
# Analyze table exports from PostgreSQL, MySQL, MSSQL, or SQLite
# DB_TYPE: postgres | mysql | mssql | sqlite
DB_TYPE=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ── Tableau (optional — planned) ──────────────────────────────────────────────
# Push quality scores to Tableau dashboards via REST API
TABLEAU_SERVER_URL=
TABLEAU_SITE_ID=
TABLEAU_TOKEN_NAME=
TABLEAU_TOKEN_VALUE=

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Security Controls (optional, recommended for shared/public deployments) ───
# Enable inbound API key auth for GuardRails API routes
API_KEY_AUTH_ENABLED=false
# Shared key clients must send via X-API-Key header when auth is enabled
CLIENT_API_KEY=
# In development, allow bypassing inbound API key auth for local testing
DEV_AUTH_BYPASS=true

# Basic request throttling
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
